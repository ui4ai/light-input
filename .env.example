# Copy to .env and fill in. The key stays on the server — it is never exposed to the client.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_HTTP_REFERER=http://localhost:5173

# Optional: force the server to use a fixed local completion instead of OpenRouter.
# Leave unset or set to "llm" for normal LLM mode.
LIGHT_INPUT_COMPLETION_MODE=llm
LIGHT_INPUT_DEMO_COMPLETION=Let's make something that actually makes a difference
