{
	"name": "light-input",
	"version": "0.0.1",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:pages": "LIGHT_INPUT_GITHUB_PAGES=true PUBLIC_LIGHT_INPUT_DEMO_ONLY=true vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"qa:oracle": "node scripts/qa/style-oracle.mjs",
		"qa:shots": "node scripts/qa/capture.mjs",
		"qa:diff": "node scripts/qa/diff-oracle.mjs",
		"qa:diff:shots": "node scripts/qa/diff-shots.mjs"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.21.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.66.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.9.3",
		"happy-dom": "^20.10.6",
		"playwright": "^1.61.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	}
}
