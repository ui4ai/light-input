{
	"name": "@ui4ai/light-input",
	"version": "0.1.0",
	"description": "Ghost-text autocomplete input for Svelte 5, with 39 per-effect light skins you import one at a time.",
	"license": "MIT",
	"homepage": "https://ui4ai.github.io/light-input/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ui4ai/light-input.git"
	},
	"bugs": {
		"url": "https://github.com/ui4ai/light-input/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"autocomplete",
		"ghost-text",
		"inline-completion",
		"input",
		"llm",
		"copilot",
		"effects"
	],
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./effects": {
			"types": "./dist/effects/index.d.ts",
			"svelte": "./dist/effects/index.js",
			"default": "./dist/effects/index.js"
		},
		"./effects/*": {
			"types": "./dist/effects/*/index.d.ts",
			"svelte": "./dist/effects/*/index.js",
			"default": "./dist/effects/*/index.js"
		},
		"./core.css": "./dist/effects/core.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"CONTRACT.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/__fixtures__",
		"!dist/**/testkit.*",
		"!dist/**/generate-fixtures.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"engines": {
		"node": ">=20.19"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:pages": "LIGHT_INPUT_GITHUB_PAGES=true PUBLIC_LIGHT_INPUT_DEMO_ONLY=true vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run check && npm test && npm run package",
		"pack-smoke": "node scripts/pack-smoke.mjs",
		"qa:oracle": "node scripts/qa/style-oracle.mjs",
		"qa:shots": "node scripts/qa/capture.mjs",
		"qa:diff": "node scripts/qa/diff-oracle.mjs",
		"qa:diff:shots": "node scripts/qa/diff-shots.mjs"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.21.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.66.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.9.3",
		"happy-dom": "^20.10.6",
		"playwright": "^1.61.1",
		"publint": "^0.3.21",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	}
}
